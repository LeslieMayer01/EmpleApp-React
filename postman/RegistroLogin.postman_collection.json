        },
        {
          "name": "Eliminar rol de registro solo si se creó en esta ejecución",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/rol/{{idRolRegistro}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.collectionVariables.get('rolRegistroCreado')!=='si')pm.execution.skipRequest();"
                ]
