              "raw": "{\n  \"nombre\": \"Registro Postman {{runId}}\",\n  \"correo\": \"admin-{{correoRegistro}}\",\n  \"contrasena\": \"{{clavePrueba}}\",\n  \"idRol\": {{idRolAdmin}}\n}",
              "options": {
