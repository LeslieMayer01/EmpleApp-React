{
  "info": {
    "name": "EmpleApp - Registro y login",
    "description": "Registro, login y sesiones con CSRF. Ejecutar completa y en orden. Requiere un rol Trabajador existente. Crea una cuenta nueva con un correo único. Las cuentas de prueba no se eliminan automáticamente: su eliminación requiere administrador. No usa credenciales reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "item": [
    {
      "name": "01 - Preparación",
      "item": [
        {
          "name": "Inicializar ejecución y consultar roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rol"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "[\"idRol\",\"idUsuario\",\"idEmpleador\",\"idTrabajador\",\"idTipoServicio\",\"idEstado\",\"idServicio\",\"idDocumento\",\"idPostulacion\",\"idContratacion\",\"idPago\",\"idUsuarioRegistro\",\"idPerfilRegistro\",\"idRolRegistro\",\"idRolAdmin\",\"rolRegistroCreado\"].forEach(k=>pm.collectionVariables.unset(k)); const run=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,8); pm.collectionVariables.set('runId',run); pm.collectionVariables.set('correoRegistro','postman-registro-'+run+'@example.test'); pm.collectionVariables.set('correoCrud','postman-crud-'+run+'@example.test'); pm.collectionVariables.set('clavePrueba','PruebaPostman2026!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const roles=pm.response.json(); pm.test('Lista JSON',()=>pm.expect(roles).to.be.an('array')); const trabajador=roles.find(r=>r.nombreRol.toLowerCase().trim()==='trabajador'); if(trabajador)pm.collectionVariables.set('idRolRegistro',trabajador.idRol); const admin=roles.find(r=>r.nombreRol.toLowerCase().includes('admin')); if(admin)pm.collectionVariables.set('idRolAdmin',admin.idRol);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Registro y login",
      "item": [
        {
          "name": "Registrar trabajador nuevo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/usuario/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Registro Postman {{runId}}\",\n  \"correo\": \"{{correoRegistro}}\",\n  \"contrasena\": \"{{clavePrueba}}\",\n  \"idRol\": {{idRolRegistro}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([\"idRolRegistro\"].some(k => !pm.collectionVariables.get(k))) { console.warn('OMITIDO: faltan datos previos para esta petición'); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if(pm.response.code===201){const u=pm.response.json();pm.collectionVariables.set('idUsuarioRegistro',u.idUsuario);pm.test('Contraseña excluida',()=>pm.expect(u).not.to.have.property('contrasenaHash'));pm.test('Correo correcto',()=>pm.expect(u.correo).to.eql(pm.collectionVariables.get('correoRegistro')));}"
                ]
              }
            }
          ]
        },
