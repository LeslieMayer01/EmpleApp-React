  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!['GET','HEAD','OPTIONS'].includes(pm.request.method) && !pm.info.requestName.startsWith('[Sin CSRF]')) {",
          "  pm.sendRequest({url:pm.variables.replaceIn('{{baseUrl}}/usuario/csrf'),method:'GET'}, (error,respuesta)=>{",
          "    pm.test('Obtener token CSRF',()=>{pm.expect(error).to.eql(null);pm.expect(respuesta.code).to.eql(200);});",
          "    if(error || !respuesta || respuesta.code!==200){pm.execution.skipRequest();return;}",
          "    const datos=respuesta.json();pm.request.headers.upsert({key:datos.headerName,value:datos.token});",
          "  });",
          "}"
        ]
      }
    }
  ]
