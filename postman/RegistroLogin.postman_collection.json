                  "const u=pm.response.json();pm.test('Usuario esperado',()=>pm.expect(u.idUsuario).to.eql(Number(pm.collectionVariables.get('idUsuarioRegistro'))));pm.test('No expone hash',()=>pm.expect(u).not.to.have.property('contrasenaHash'));"
                ]
              }
            }
          ]
