        {
          "name": "Login correcto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/usuario/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoRegistro}}\",\n  \"contrasena\": \"{{clavePrueba}}\"\n}",
