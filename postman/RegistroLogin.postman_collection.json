    {
      "name": "03 - Limpieza de las cuentas de prueba",
      "item": [
        {
          "name": "Eliminar perfil de registro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/trabajador/{{idPerfilRegistro}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([\"idPerfilRegistro\"].some(k => !pm.collectionVariables.get(k))) { console.warn('OMITIDO: faltan datos previos para esta petición'); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar cuenta de registro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/usuario/{{idUsuarioRegistro}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([\"idUsuarioRegistro\"].some(k => !pm.collectionVariables.get(k))) { console.warn('OMITIDO: faltan datos previos para esta petición'); pm.execution.skipRequest(); }"
                ]
